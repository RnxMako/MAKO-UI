        if Section.Icon then
            local I = VexUI:Create("ImageLabel", {
                Parent = Head, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0),
                Size = UDim2.new(0, 16, 0, 16), ZIndex = 6, ThemeID = { ImageColor3 = "IconColor" },
            })
            SetIcon(I, Section.Icon)
        end

        local Roll = VexUI:Create("Frame", {
            Parent = SectionFrame, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AutoY,
            ClipsDescendants = true, BackgroundTransparency = 1,
        }, { Utility:ListLayout("V", 4) })
        local RollLayout = Roll:FindFirstChildOfClass("UIListLayout")

        local token = 0
        local function setOpen(open, instant)
            isOpen = open
            token += 1
            local my = token
            Utility:TweenObject(Arrow, { Rotation = open and 180 or 0 }, 0.16)
            if open then
                if instant then Roll.AutomaticSize = AutoY Roll.Size = UDim2.new(1, 0, 0, 0) return end
                Roll.AutomaticSize = AutoNone
                Utility:TweenObject(Roll, { Size = UDim2.new(1, 0, 0, Unscale(RollLayout.AbsoluteContentSize.Y)) }, 0.2)
                task.delay(0.24, function()
                    if token == my and isOpen then Roll.AutomaticSize = AutoY Roll.Size = UDim2.new(1, 0, 0, 0) end
                end)
            else
                Roll.Size = UDim2.new(1, 0, 0, Unscale(Roll.AbsoluteSize.Y))
                Roll.AutomaticSize = AutoNone
                if instant then Roll.Size = UDim2.new(1, 0, 0, 0)
                else Utility:TweenObject(Roll, { Size = UDim2.new(1, 0, 0, 0) }, 0.2) end
            end
        end
        Head.Activated:Connect(function() setOpen(not isOpen) end)
        if not isOpen then setOpen(false, true) end

        function Section:Tab(c) return Window:Tab(c, Roll) end
        function Section:Toggle(v) if v == nil then v = not isOpen end setOpen(v and true or false) end
        return Section
    end

