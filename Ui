    function Window:CreateTopbarToggle(Cfg)
        Cfg = Cfg or {}
        local T = {
            Icon = Cfg.Icon or "bird", Callback = Cfg.Callback or function() end, Order = Cfg.Order or 1,
            Default = Cfg.Default or false, EnableIcon = Cfg.EnableIcon or Cfg.Icon or "bird",
            DisableIcon = Cfg.DisableIcon or Cfg.Icon or "bird",
            EnableBackground = Cfg.EnableBackground, DisableBackground = Cfg.DisableBackground,
        }
        local Btn, Hit, Img = TopButtonBase(T.Order)
        local function state(fire)
            local on = T.Default
            SetIcon(Img, on and T.EnableIcon or T.DisableIcon)
            if on then
                if T.EnableBackground then
                    VexUI.Objects[Btn] = nil
                    Utility:TweenObject(Btn, { BackgroundColor3 = T.EnableBackground, BackgroundTransparency = 0 }, 0.2)
                else
                    VexUI:SetThemeKey(Btn, "BackgroundColor3", "Accent")
                    Utility:TweenObject(Btn, { BackgroundTransparency = 0.3 }, 0.2)
                end
            else
                if T.DisableBackground then
                    VexUI.Objects[Btn] = nil
                    Utility:TweenObject(Btn, { BackgroundColor3 = T.DisableBackground, BackgroundTransparency = 0.6 }, 0.2)
                else
                    VexUI:SetThemeKey(Btn, "BackgroundColor3", "Background")
                    Utility:TweenObject(Btn, { BackgroundTransparency = 0.6 }, 0.2)
                end
            end
            if fire then Safe(T.Callback, on) end
        end
        state(true)
        Hit.Activated:Connect(function()
            T.Default = not T.Default
            state(true)
        end)
        function T:SetValue(v) T.Default = v and true or false state(true) end
        function T:GetValue() return T.Default end
        return T
    end

