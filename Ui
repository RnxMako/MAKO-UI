        }, { Corner(2) })
        local TabTRG = VexUI:Create("TextButton", { Parent = TabBack, Size = UDim2.new(1, 0, 1, 0), ZIndex = 6 })

        local Page = VexUI:Create("Frame", {
            Parent = PagesHolder, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0.35, Visible = false,
            ThemeID = { BackgroundColor3 = "SideBar" },
        }, { Corner(16), GStroke({ Alt = true, Thickness = 0.6 }) })
        local RightScroll = VexUI:Create("ScrollingFrame", {
            Parent = Page, Position = UDim2.new(0, 0, 0, 5), Size = UDim2.new(1, 0, 1, -10),
            AutomaticCanvasSize = AutoY, ScrollBarThickness = 3, ScrollBarImageTransparency = 0.4,
            ScrollingDirection = Enum.ScrollingDirection.Y, ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
            ClipsDescendants = true, ThemeID = { ScrollBarImageColor3 = "IconColor" },
        }, {
            Utility:ListLayout("V", 5),
            Utility:Padding({ top = 5, bottom = 8, left = 6, right = 10 }),
        })

        local active = false
        Tab._SetActive = function(state)
            active = state
            Utility:TweenObject(TabBack, { BackgroundTransparency = state and 0.65 or 1 }, 0.2)
            Utility:TweenObject(TabStroke, { Transparency = (state and Tab.Border) and 0 or 1 }, 0.2)
            Utility:TweenObject(TabTitle, { TextTransparency = state and 0 or 0.45 }, 0.2)
            Utility:TweenObject(AccentBar, { BackgroundTransparency = state and 0 or 1 }, 0.2)
            if TabIcon then Utility:TweenObject(TabIcon, { ImageTransparency = state and 0 or 0.45 }, 0.2) end
            if state then
                Page.Visible = true
                Page.BackgroundTransparency = 0.8
                RightScroll.Position = UDim2.new(0, 0, 0, 16)
                Utility:TweenObject(Page, { BackgroundTransparency = 0.35 }, 0.25)
                Utility:TweenObject(RightScroll, { Position = UDim2.new(0, 0, 0, 5) }, 0.25, QuadOut, DirOut)
            else
                Page.Visible = false
            end
        end

        TabTRG.MouseEnter:Connect(function()
            if not active then Utility:TweenObject(TabBack, { BackgroundTransparency = 0.88 }, 0.12) end
        end)
        TabTRG.MouseLeave:Connect(function()
            if not active then Utility:TweenObject(TabBack, { BackgroundTransparency = 1 }, 0.12) end
        end)

        local function SelectTab()
            if Window.CurrentTabObj == Tab and active then return end
            for _, t in ipairs(Window.TabList) do
                if t ~= Tab then t._SetActive(false) end
            end
            Window.CurrentTabObj = Tab
            Window.CurrentTab = Tab
            Window.ActiveElementFrame = Page
            Tab._SetActive(true)
            Safe(Tab.Callback)
        end
        Tab.Select = function() SelectTab() end
        TabTRG.Activated:Connect(SelectTab)

        table.insert(Window.Tabs, TabBack)
        table.insert(Window.TabOrder, Tab.Title)
        table.insert(Window.TabList, Tab)
        table.insert(Window.SearchIndex, {
            Title = Tab.Title, Icon = Tab.Icon or "layout-grid", Type = "Tab", TabTitle = "Tab",
            SelectFn = SelectTab, Frame = TabBack, Scroll = RightScroll,
        })

        local ctx = NewCtx(Tab, RightScroll, RightScroll)
        AttachElementMethods(Tab, ctx)

        if #Window.TabList == 1 then
            task.defer(function()
                if not Window.CurrentTabObj then SelectTab() end
            end)
        end
        return Tab
    end

