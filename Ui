                local BC = pair[col]
                Dialog.Count += 1
                local B = VexUI:Create("TextButton", {
                    Parent = Row, LayoutOrder = col, Size = (n == 1) and UDim2.new(1, 0, 1, 0) or UDim2.new(0.5, -3, 1, 0),
                    Text = BC.Text or "Button", TextSize = 13, BackgroundTransparency = BC.Primary and 0.1 or 0.3, ZIndex = 103,
                    ThemeID = {
                        BackgroundColor3 = BC.Primary and "Accent" or "Dialog.Button|ElementColor", TextColor3 = "Text",
                    },
                }, { Corner(11) })
                B.Activated:Connect(function()
                    Safe(BC.Callback)
                    Close()
                end)
            end
        end
        return Dialog
    end

    -- proxy on UI so old code (UI:Dialog / UI:CreateTopbarButton) still works
    UI.Dialog = function(_, c) return Window:Dialog(c) end
    UI.CreateTopbarButton = function(_, c) return Window:CreateTopbarButton(c) end
    UI.CreateTopbarToggle = function(_, c) return Window:CreateTopbarToggle(c) end

    -- Scale ----------------------------------------------------------
    local function ComputeAutoScale()
        local cam = workspace.CurrentCamera
        if not cam then return 1 end
        local vp = cam.ViewportSize
        local margin = IsMobile and 14 or 40
        local sx = (vp.X - margin * 2) / Window.Size.X.Offset
        local sy = (vp.Y - margin * 2) / Window.Size.Y.Offset
        return math.clamp(math.min(sx, sy), 0.35, 1)
    end
    function Window:SetUIScale(v)
        Window._ManualScale = true
        Utility.Scale = v
        Utility:TweenObject(MainScale, { Scale = v }, 0.2, Enum.EasingStyle.Quint, DirOut)
        return Window
    end
    function Window:SetAutoScale(v)
        Window.AutoScale = v and true or false
        if Window.AutoScale then
            Window._ManualScale = false
            local s = ComputeAutoScale()
            Utility.Scale = s
            Utility:TweenObject(MainScale, { Scale = s }, 0.2)
        end
    end
    function Window:GetUIScale() return Window.Size end
    local function ApplyAutoScale()
        if Window.AutoScale and not Window._ManualScale then
            local s = ComputeAutoScale()
            Utility.Scale = s
            Utility:TweenObject(MainScale, { Scale = s }, 0.2)
        end
    end
    do
        local s = Window.AutoScale and ComputeAutoScale() or 1
        Utility.Scale = s
        MainScale.Scale = s
    end
    local cam = workspace.CurrentCamera
    if cam then Window:_Connect(cam:GetPropertyChangedSignal("ViewportSize"), ApplyAutoScale) end

    -- Resize ---------------------------------------------------------
    function Window:Resize(sizeX, sizeY, instant)
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
        local scale = math.max(Utility.Scale, 0.01)
        local maxX = math.min(MAX_W, math.floor((vp.X - 8) / scale))
        local maxY = math.min(MAX_H, math.floor((vp.Y - 8) / scale))
        sizeX = math.clamp(sizeX, MIN_W, math.max(MIN_W, maxX))
        sizeY = math.clamp(sizeY, MIN_H, math.max(MIN_H, maxY))
        Window.Size = UDim2.new(0, sizeX, 0, sizeY)
        if instant then
            Main.Size = Window.Size
        else
            Utility:TweenObject(Main, { Size = Window.Size }, 0.25, Enum.EasingStyle.Back, DirOut)
        end
        LayoutTopbar()
    end
    function Window:GetWindowSize() return Window.Size.X.Offset, Window.Size.Y.Offset end
    function Window:SetResizable(v)
        Window.Resizable = v and true or false
        ResizeHandle.Visible = Window.Resizable
    end

    do
        local resizing, rInput, startPos, startSize = false, nil, nil, nil
        ResizeHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                rInput = input
                startPos = input.Position
                startSize = Window.Size
                Utility:TweenObject(HandleImg, { ImageTransparency = 0 }, 0.1)
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        resizing = false
                        Utility:TweenObject(HandleImg, { ImageTransparency = 0.8 }, 0.15)
                    end
                end)
            end
        end)
        ResizeHandle.MouseEnter:Connect(function() Utility:TweenObject(HandleImg, { ImageTransparency = 0.35 }, 0.15) end)
        ResizeHandle.MouseLeave:Connect(function()
            if not resizing then Utility:TweenObject(HandleImg, { ImageTransparency = 0.8 }, 0.15) end
        end)
        Window:_Connect(UserInputService.InputChanged, function(input)
            if resizing and (input == rInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
                local d = (input.Position - startPos) / math.max(Utility.Scale, 0.01)
                Window:Resize(startSize.X.Offset + d.X, startSize.Y.Offset + d.Y, true)
            end
        end)
    end

    -- Dragging (topbar only) ----------------------------------------
    table.insert(Window._Connections, EnableDragging(TopBarF1, Main))

    -- Open / Close ---------------------------------------------------
    function Window:Open()
        if Window.IslandOpen then return end
        Window.IslandOpen = true
        UI.IslandOpen = true
        Window.Default = "Default"
        Main.Visible = true
        Main.Size = UDim2.new(0, Window.Size.X.Offset, 0, 0)
        Utility:TweenObject(Main, { Size = Window.Size }, 0.3, Enum.EasingStyle.Back, DirOut)
        local t = Window.TransparencyNum
        Utility:TweenObject(Main, { BackgroundTransparency = t }, 0.25)
        ResizeHandle.Visible = Window.Resizable
        ShowIsland(false)
        task.delay(0.3, function() MinzUI.Visible = false end)
    end
    function Window:Close()
        if not Window.IslandOpen then return end
        Window.IslandOpen = false
        UI.IslandOpen = false
        Window.Default = "Minimize"
        MinzUI.Visible = true
        ResizeHandle.Visible = false
        Utility:TweenObject(Main, { Size = UDim2.new(0, Window.Size.X.Offset, 0, 0), BackgroundTransparency = 1 }, 0.25, QuadIn, DirIn)
        task.delay(0.26, function() if not Window.IslandOpen then Main.Visible = false end end)
        ShowIsland(true)
    end
    function Window:Toggle()
        if Window.IslandOpen then Window:Close() else Window:Open() end
    end

    MinBtn.Activated:Connect(function() Window:Close() end)
    MinzUI.Activated:Connect(function() Window:Open() end)

    function Window:OnDestroy(cb) Window._OnDestroy = cb or function() end end
    function Window:Destroy()
        Safe(Window._OnDestroy)
        for _, c in ipairs(Window._Connections) do pcall(function() c:Disconnect() end) end
        Window._Connections = {}
        Window.IslandOpen = false
        ResizeHandle.Visible = false
        Utility:TweenObject(Main, { Size = UDim2.new(0, Window.Size.X.Offset, 0, 0), BackgroundTransparency = 1 }, 0.25, QuadIn, DirIn)
        for i, w in ipairs(UI.Windows) do if w == Window then table.remove(UI.Windows, i) break end end
        task.delay(0.27, function()
            if #UI.Windows == 0 then
                UIScreen:Destroy()
            else
                Main:Destroy()
                MinzUI:Destroy()
            end
        end)
    end
    CloseBtn.Activated:Connect(function() Window:Destroy() end)

    -- Toggle key ----------------------------------------------------
    Window:_Connect(UserInputService.InputBegan, function(input, gp)
        if gp then return end
        if input.KeyCode == Window.ToggleKey then Window:Toggle() end
    end)
    function Window:SetToggleKey(v)
        if type(v) == "string" then v = Enum.KeyCode[v] end
        Window.ToggleKey = v or Window.ToggleKey
        return Window
    end

    -- Misc API --------------------------------------------------------
    function Window:SetTitle(v) LibName.Text = v MinzLabel.Text = v end
    function Window:SetAuthor(v)
        Window.Author = v
        LibAuthor.Text = v or ""
        LibAuthor.Visible = v ~= nil and v ~= ""
        LibName.TextYAlignment = LibAuthor.Visible and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center
        LibName.UIPadding.PaddingTop = UDim.new(0, LibAuthor.Visible and 5 or 0)
    end
    function Window:ToCenter()
        Utility:TweenObject(Main, { Position = UDim2.new(0.5, 0, 0.5, 0) }, 0.2)
    end
    function Window:SetTransparency(Value)
        if typeof(Value) == "boolean" then
            Window.TransparencyNum = Value and 0.3 or 0
        elseif typeof(Value) == "number" then
            Window.TransparencyNum = math.clamp(Value, 0, 1)
        else
            return Window
        end
        ApplySurfaces()
        return Window
    end
    function Window:GetTransparency() return Window.TransparencyNum end
    function Window:GetTheme() return Window.Theme end
    function Window:Notify(c) return UI:Notification(c) end

    ApplySurfaces()
    ShowIsland(false)
    Island.Visible = false

    return Window
end

return UI
