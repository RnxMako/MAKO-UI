            active = state
            Utility:TweenObject(TabBack, { BackgroundTransparency = state and 0.65 or 1 }, 0.2)
            Utility:TweenObject(TabStroke, { Transparency = (state and Tab.Border) and 0 or 1 }, 0.2)
            Utility:TweenObject(TabTitle, { TextTransparency = state and 0 or 0.45 }, 0.2)
            Utility:TweenObject(AccentBar, { BackgroundTransparency = state and 0 or 1 }, 0.2)
            if TabIcon then Utility:TweenObject(TabIcon, { ImageTransparency = state and 0 or 0.45 }, 0.2) end
            if state then
                Page.Visible = true
                Page.BackgroundTransparency = 0.8
                RightScroll.Position = UDim2.new(0, 0, 0, 16)
                Utility:TweenObject(Page, { BackgroundTransparency = 0.35 }, 0.25)
                Utility:TweenObject(RightScroll, { Position = UDim2.new(0, 0, 0, 5) }, 0.25, QuadOut, DirOut)
            else
                Page.Visible = false
            end
        end

        TabTRG.MouseEnter:Connect(function()
            if not active then Utility:TweenObject(TabBack, { BackgroundTransparency = 0.88 }, 0.12) end
        end)
        TabTRG.MouseLeave:Connect(function()
            if not active then Utility:TweenObject(TabBack, { BackgroundTransparency = 1 }, 0.12) end
        end)

        local function SelectTab()
            if Window.CurrentTabObj == Tab and active then return end
            for _, t in ipairs(Window.TabList) do
                if t ~= Tab then t._SetActive(false) end
            end
            Window.CurrentTabObj = Tab
            Window.CurrentTab = Tab
            Window.ActiveElementFrame = Page
            Tab._SetActive(true)
            Safe(Tab.Callback)
        end
        Tab.Select = function() SelectTab() end
        TabTRG.Activated:Connect(SelectTab)

        table.insert(Window.Tabs, TabBack)
