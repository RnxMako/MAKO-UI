function VexUI:Create(class, properties, children)
    properties = properties or {}
    local inst = Instance.new(class)

    local defaults = VexUI.DefaultProps[class]
    if defaults then
        for prop, val in next, defaults do
            if properties[prop] == nil then inst[prop] = val end
        end
    end

    for prop, value in next, properties do
        if prop ~= "ThemeID" and prop ~= "Parent" then
            inst[prop] = value
        end
    end

    for _, child in next, children or {} do
        child.Parent = inst
    end

    if properties.ThemeID then
        VexUI:AddThemeObject(inst, properties.ThemeID)
    end
    if properties.Parent then
        inst.Parent = properties.Parent
    end
    return inst
end

function VexUI:GetThemeProperty(property, theme, fallbackProperty)
    local function resolve(t, key)
        for _, part in ipairs(string.split(key, ".")) do
            if type(t) ~= "table" then return nil end
            t = t[part]
        end
        return t
    end
    return resolve(theme, property)
        or resolve(VexUI.Themes.Dark, property)
        or (fallbackProperty and (resolve(theme, fallbackProperty) or resolve(VexUI.Themes.Dark, fallbackProperty)))
end

function VexUI:AddThemeObject(object, properties)
    local copy = {}
    for k, v in pairs(properties) do copy[k] = v end
    VexUI.Objects[object] = { Object = object, Properties = copy }
    pcall(function()
        object.Destroying:Connect(function() VexUI.Objects[object] = nil end)
    end)
    VexUI:UpdateTheme(object, false)
    return object
end

function VexUI:SetThemeKey(object, property, key)
    local data = VexUI.Objects[object]
    if data then
        data.Properties[property] = key
        VexUI:UpdateTheme(object, true)
    else
        VexUI:AddThemeObject(object, { [property] = key })
    end
end

function VexUI:UpdateTheme(targetObject, isTween)
    local function Apply(objData)
        local obj = objData.Object
        if not obj then return end
        for property, colorKey in pairs(objData.Properties or {}) do
            local color
            for _, key in ipairs(string.split(colorKey, "|")) do
                key = key:gsub("%s+", "")
                color = VexUI:GetThemeProperty(key, UI.Theme)
                if color then break end
            end
            if color then
                if isTween then
                    Utility:TweenObject(obj, { [property] = color }, 0.25)
                else
                    pcall(function() obj[property] = color end)
                end
            end
        end
    end

    if targetObject then
        local data = VexUI.Objects[targetObject]
        if data then Apply(data) end
    else
        for _, data in pairs(VexUI.Objects) do Apply(data) end
    end
end

function VexUI:SetTheme(themeName)
    local theme = VexUI.Themes[themeName]
    if not theme then
        warn("Theme '" .. tostring(themeName) .. "' not found.")
        return false
    end
    UI.Theme = theme
    VexUI:UpdateTheme(nil, true)
    for _, fn in ipairs(VexUI.Listeners) do Safe(fn, theme) end
    return true
end

function UI:SetTheme(name) return VexUI:SetTheme(name) end
function UI:AddTheme(i)
