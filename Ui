Builders.Group = function(ctx, Config)
    Config = Config or {}
    local Padding = Config.Padding or 5
    local GroupFrame = VexUI:Create("Frame", {
        Parent = ctx.Parent, BackgroundTransparency = 1, AutomaticSize = AutoY, Size = UDim2.new(1, 0, 0, 0),
    }, {
        VexUI:Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Left,
            VerticalAlignment = Enum.VerticalAlignment.Top, SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, Padding),
        }),
    })

    local function Resize()
        local kids = {}
        for _, c in ipairs(GroupFrame:GetChildren()) do
            if c:IsA("Frame") then table.insert(kids, c) end
        end
        local n = math.max(1, #kids)
        local off = -(Padding * (n - 1) / n)
        for _, c in ipairs(kids) do
            c.Size = UDim2.new(1 / n, off, 0, c.Size.Y.Offset)
        end
    end

    local Group = { Root = GroupFrame }
    local gctx = setmetatable({ Parent = GroupFrame, OnAdd = Resize }, { __index = ctx })
    AttachElementMethods(Group, gctx)
    function Group:Close() GroupFrame:Destroy() end
    return Group
end

