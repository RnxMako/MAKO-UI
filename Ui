            Title = Tab.Title, Icon = Tab.Icon or "layout-grid", Type = "Tab", TabTitle = "Tab",
            SelectFn = SelectTab, Frame = TabBack, Scroll = RightScroll,
        })

        local ctx = NewCtx(Tab, RightScroll, RightScroll)
        AttachElementMethods(Tab, ctx)

        if #Window.TabList == 1 then
            task.defer(function()
                if not Window.CurrentTabObj then SelectTab() end
            end)
        end
        return Tab
    end

