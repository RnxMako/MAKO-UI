local IconsV2
do
    local url = "https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua"
    local ok, lib = pcall(function()
        local src
        local ok1, r1 = pcall(function() return game:HttpGetAsync(url) end)
        if ok1 and r1 then
            src = r1
        else
            src = game:HttpGet(url)
        end
        return loadstring(src)()
    end)
    IconsV2 = ok and lib or nil
    if IconsV2 then pcall(IconsV2.SetIconsType, "lucide") end
end

local IconCache = {}
local function ResolveIcon(icon)
    if icon == nil or icon == "" then return nil end
    if typeof(icon) == "table" then return icon end
    if typeof(icon) ~= "string" then return nil end
    if icon:find("rbxassetid://") or icon:find("rbxasset://") then return icon end
    if icon:match("^%d+$") then return "rbxassetid://" .. icon end
    local cached = IconCache[icon]
    if cached ~= nil then return cached or nil end
    if not IconsV2 then return nil end
    local pack, name = icon:match("^([^:]+):(.+)$")
    local result
    pcall(function()
        if pack and name then
            IconsV2.SetIconsType(string.lower(pack))
            result = IconsV2.GetIcon(name)
            IconsV2.SetIconsType("lucide")
        else
            IconsV2.SetIconsType("lucide")
            result = IconsV2.GetIcon(icon)
        end
    end)
    IconCache[icon] = result or false
    return result
end

local function SetIcon(img, icon)
    local r = ResolveIcon(icon)
    if typeof(r) == "table" then
        img.Image = r.Image or ""
        local off = r.ImageRectOffset or r.ImageRectPosition
        if off then img.ImageRectOffset = off end
        if r.ImageRectSize then img.ImageRectSize = r.ImageRectSize end
        return true
    elseif typeof(r) == "string" then
        img.Image = r
        return true
    end
    return false
end

