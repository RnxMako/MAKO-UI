local Utility = { Scale = 1 }

function Utility:TweenObject(obj, properties, duration, ...)
    if not obj then return end
    local info
    if select("#", ...) == 0 then
        info = TweenInfo.new(duration or 0.2, QuadOut, DirOut)
    else
        info = TweenInfo.new(duration or 0.2, ...)
    end
    local ok, tween = pcall(TweenService.Create, TweenService, obj, info, properties)
    if ok and tween then
        tween:Play()
        return tween
    end
end

local function Safe(fn, ...)
    if type(fn) ~= "function" then return end
    local args = table.pack(...)
    task.spawn(function()
        local ok, err = pcall(fn, table.unpack(args, 1, args.n))
        if not ok then warn("[VexUI] callback error: " .. tostring(err)) end
    end)
end

local function Unscale(px)
    return px / math.max(Utility.Scale, 0.01)
end

local function Decimals(n)
    local d = tostring(n):match("%.(%d+)")
    return d and #d or 0
end

local function RoundTo(v, step)
    step = (step and step > 0) and step or 1
    local r = math.floor(v / step + 0.5) * step
    local d = Decimals(step)
    return tonumber(string.format("%." .. d .. "f", r)) or r
end

local function Contrast(c)
    local l = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
    return l > 0.6 and Color3.fromRGB(20, 20, 20) or Color3.new(1, 1, 1)
end

