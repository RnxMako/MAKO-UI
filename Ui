    local Main = VexUI:Create("Frame", {
        Name = Window.Name, Parent = UIScreen, Size = Window.Size, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0), ClipsDescendants = true, Active = true,
