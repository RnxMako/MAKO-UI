function UI:CreateWindow(Config)
    Config = Config or {}
    local reqSize = Config.Size
    local MIN_W, MAX_W, MIN_H, MAX_H = 360, 900, 260, 700
    local wx = reqSize and reqSize.X.Offset or 480
    local wy = reqSize and reqSize.Y.Offset or 360

    local Window = {
        Name = Config.Name or "VexUI", Author = Config.Author, Icon = Config.Icon,
        ToggleKey = Config.ToggleKey or Enum.KeyCode.F,
        Transparent = Config.Transparent or false,
        Theme = Config.Theme or "Dark", Folder = Config.Folder, KeySystem = Config.KeySystem,
        Default = "Default",
        AutoScale = (Config.AutoScale == nil) and true or Config.AutoScale,
        Resizable = (Config.Resizable == nil) and true or Config.Resizable,
        Topbar = { Height = Config.Height or 36 },
        Themes = VexUI.Themes,
        Size = UDim2.new(0, math.clamp(wx, MIN_W, MAX_W), 0, math.clamp(wy, MIN_H, MAX_H)),
        SideBarWidth = Config.SideBarWidth or (IsMobile and 150 or 160),
        TransparencyNum = Config.TransparencyNum or (Config.Transparent and 0.25 or 0),
        User = Config.User or {},
        Tabs = {}, TabList = {}, TabOrder = {}, SearchIndex = {}, AllElements = {}, CurrentTab = {},
        IslandOpen = true, _Connections = {}, _OnDestroy = Config.OnDestroy or function() end,
        _ManualScale = false,
    }
    if type(Window.ToggleKey) == "string" then
        Window.ToggleKey = Enum.KeyCode[Window.ToggleKey] or Enum.KeyCode.F
    end
    table.insert(UI.Windows, Window)
    UI.Window = Window

    function Window:_Connect(signal, fn)
        local c = signal:Connect(fn)
        table.insert(Window._Connections, c)
        return c
    end

    function Window:SetTheme(themeName)
        if VexUI:SetTheme(themeName) then Window.Theme = themeName end
    end
    VexUI:SetTheme(Window.Theme)

    local TH = Window.Topbar.Height
    local F3W = 190

    -- Key system -------------------------------------------------------
    if Window.KeySystem and Window.KeySystem.KeyValidator then
        local KS = Window.KeySystem
        local folder = "VexUI/" .. (Window.Folder or "Temp")
        local keyPath = folder .. "/key.json"
        local saved
        pcall(function()
            if not isfolder("VexUI") then makefolder("VexUI") end
            if not isfolder(folder) then makefolder(folder) end
            if isfile(keyPath) then saved = HttpService:JSONDecode(readfile(keyPath)).key end
        end)

        local autoOk = false
        if saved and saved ~= "" then
            local ok, res = pcall(KS.KeyValidator, saved)
            autoOk = ok and res == true
        end

        if not autoOk then
            local done = Instance.new("BindableEvent")
            local KeyPanel = VexUI:Create("Frame", {
                Parent = UIScreen, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
                Size = UDim2.new(0, 270, 0, 156), Active = true, ThemeID = { BackgroundColor3 = "Background" },
            }, {
                Corner(18), GStroke({ Thickness = 1 }),
                VexUI:Create("UIScale", { Scale = IsMobile and 0.9 or 1 }),
            })
            CreateText(KeyPanel, KS.Title or "Key System", {
                Position = UDim2.new(0, 0, 0, 12), Size = UDim2.new(1, -50, 0, 0), TextSize = 14, PaddingLeft = 16, ZIndex = 2,
            })
            CreateText(KeyPanel, KS.Desc or "Enter your key to continue", {
                Position = UDim2.new(0, 0, 0, 36), Size = UDim2.new(1, 0, 0, 0), TextSize = 11, PaddingLeft = 16,
                PaddingRight = 16, TextTransparency = 0.45, ZIndex = 2,
            })
            local Cross = VexUI:Create("ImageButton", {
                Parent = KeyPanel, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10),
                Size = UDim2.new(0, 22, 0, 22), ThemeID = { ImageColor3 = "IconColor" }, ZIndex = 3,
            })
            SetIcon(Cross, "x")
            Cross.Activated:Connect(function() UIScreen:Destroy() end)

            local BoxFrame = VexUI:Create("Frame", {
                Parent = KeyPanel, Position = UDim2.new(0, 16, 0, 78), Size = UDim2.new(1, -32, 0, 32),
                BackgroundTransparency = 0.2, ThemeID = { BackgroundColor3 = "SideBar" },
            }, { Corner(12), GStroke({ Alt = true }) })
            local KeyBox = VexUI:Create("TextBox", {
                Parent = BoxFrame, Size = UDim2.new(1, 0, 1, 0), Text = saved or "", PlaceholderText = "Key . . .",
                ClearTextOnFocus = false, TextSize = 12, TextXAlignment = Left, ZIndex = 3,
                ThemeID = { TextColor3 = "Text" },
            }, { Utility:Padding({ left = 12, right = 8 }) })

            local function mkBtn(text, x, w, key)
                local b = VexUI:Create("TextButton", {
                    Parent = KeyPanel, Position = UDim2.new(x, x == 0 and 16 or 4, 0, 118), Size = UDim2.new(w, -20, 0, 28),
                    Text = text, TextSize = 12, BackgroundTransparency = 0.1, ZIndex = 3,
                    ThemeID = { BackgroundColor3 = key, TextColor3 = "Text" },
                }, { Corner(12) })
                return b
            end
            local Apply = mkBtn("Apply", 0, 0.55, "Accent")
            local Get = mkBtn("Get Key", 0.55, 0.45, "ElementColor")

            Apply.Activated:Connect(function()
                local inputKey = KeyBox.Text:gsub("%s+", "")
                if inputKey == "" then return end
                Apply.Text = "..."
                local ok, res = pcall(KS.KeyValidator, inputKey)
                if ok and res == true then
                    pcall(function() writefile(keyPath, HttpService:JSONEncode({ key = inputKey })) end)
                    Apply.Text = "Success"
                    task.wait(0.4)
                    KeyPanel:Destroy()
                    done:Fire()
                else
                    Apply.Text = "Invalid"
                    task.wait(1)
                    Apply.Text = "Apply"
                end
            end)
            Get.Activated:Connect(function()
                pcall(function() setclipboard(KS.URL or "") end)
                Get.Text = "Copied!"
                task.wait(1)
                Get.Text = "Get Key"
            end)
            done.Event:Wait()
            done:Destroy()
        end
    end

