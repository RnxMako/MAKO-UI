    local Card, Inner = NewCard(ctx, 40, { Color = Paragraph.Color, NoStroke = colored, Transparency = colored and 0.2 or 0.5 })
    Inner.UIListLayout.Padding = UDim.new(0, 4)
    local txtColor = colored and Contrast(Paragraph.Color) or nil

    local Thumb
    if Paragraph.Thumbnail then
        Thumb = VexUI:Create("ImageLabel", {
            Parent = Inner, Image = Paragraph.Thumbnail, Size = UDim2.new(1, -16, 0, Paragraph.ThumbnailSize),
            ScaleType = Enum.ScaleType[Paragraph.ScaleType] or Enum.ScaleType.Crop,
            LayoutOrder = (Paragraph.ThumbnailPos == "Up") and 1 or 3,
        }, { Corner(12), Utility:Padding(0) })
        Thumb.Position = UDim2.new(0, 8, 0, 0)
    end

    local TextFrame = VexUI:Create("Frame", {
        Parent = Inner, BackgroundTransparency = 1, AutomaticSize = AutoY, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2,
    }, { Utility:ListLayout("V", 1, Enum.VerticalAlignment.Center) })
    local Title, Desc = Utility:ElText(TextFrame, Paragraph.Title, Paragraph.Desc, { Static = colored, TextColor3 = txtColor })

    if Paragraph.Icon then
        local Icon = VexUI:Create("ImageLabel", {
            Parent = TextFrame, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0),
            Size = UDim2.new(0, Paragraph.IconSize, 0, Paragraph.IconSize), ZIndex = 3,
            ImageColor3 = txtColor, ThemeID = (not colored) and { ImageColor3 = "IconColor" } or nil,
        })
        SetIcon(Icon, Paragraph.Icon)
        Title.UIPadding.PaddingLeft = UDim.new(0, Paragraph.IconSize + 20)
        Desc.UIPadding.PaddingLeft = UDim.new(0, Paragraph.IconSize + 20)
    end

    function Paragraph:SetThumbnail(v) if Thumb then Thumb.Image = v else warn("Thumbnail Not Found In Paragraph!") end end
    function Paragraph:SetPos(v) if Thumb then Thumb.LayoutOrder = (v == "Up") and 1 or 3 else warn("Thumbnail Not Found In Paragraph!") end end
    function Paragraph:SetThumbnailSize(v) if Thumb then Thumb.Size = UDim2.new(1, -16, 0, v) else warn("Thumbnail Not Found In Paragraph!") end end

    local entry = ctx:Register({ Title = Paragraph.Title, Desc = Paragraph.Desc, Icon = Paragraph.Icon or "text", Type = "Paragraph", Frame = Card })
    FinishElement(ctx, Paragraph, Card, entry, Title, Desc)
    return Paragraph
end

