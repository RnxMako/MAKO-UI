function UI:Notification(Config)
    Config = Config or {}
    local N = {
        Title = Config.Title or "Notification", Desc = Config.Desc, Icon = Config.Icon,
        Duration = Config.Duration or 5, Type = Config.Type,
    }
    local typeInfo = N.Type and NotifTypes[N.Type]
    if typeInfo and not N.Icon then N.Icon = typeInfo.Icon end
    local accentColor = typeInfo and typeInfo.Color or nil

    -- cap stack
    local kids = {}
    for _, c in ipairs(NotifHolder:GetChildren()) do
        if c:IsA("Frame") then table.insert(kids, c) end
    end
    if #kids >= 5 then kids[1]:Destroy() end

    local Wrapper = VexUI:Create("Frame", {
        Parent = NotifHolder, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AutoY,
    })
    local Card = VexUI:Create("Frame", {
        Parent = Wrapper, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AutoY, ClipsDescendants = true,
        BackgroundTransparency = 1, Position = UDim2.new(0, 40, 0, 0),
        ThemeID = { BackgroundColor3 = "SideBar" },
    }, { Corner(14), GStroke({ Alt = true }) })

    local leftPad = N.Icon and 42 or 14
    local Inner = VexUI:Create("Frame", {
        Parent = Card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AutoY, BackgroundTransparency = 1,
    }, { Utility:ListLayout("V", 2), Utility:Padding({ top = 10, bottom = 13, left = 0, right = 12 }) })

    CreateText(Inner, N.Title, { TextSize = 13, PaddingLeft = leftPad, LayoutOrder = 1 })
    if N.Desc and N.Desc ~= "" then
        CreateText(Inner, N.Desc, { TextSize = 11, PaddingLeft = leftPad, LayoutOrder = 2, TextTransparency = 0.4 })
    end

    if N.Icon then
        local icon = VexUI:Create("ImageLabel", {
            Parent = Card, Position = UDim2.new(0, 12, 0, 10), Size = UDim2.new(0, 20, 0, 20), ZIndex = 3,
            ImageColor3 = accentColor,
            ThemeID = (not accentColor) and { ImageColor3 = "Accent" } or nil,
        })
        SetIcon(icon, N.Icon)
    end

    local Bar = VexUI:Create("Frame", {
        Parent = Card, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2), ZIndex = 4, BackgroundTransparency = 0.2,
        BackgroundColor3 = accentColor,
        ThemeID = (not accentColor) and { BackgroundColor3 = "Accent" } or nil,
    })

    local Click = VexUI:Create("TextButton", { Parent = Card, Size = UDim2.new(1, 0, 1, 0), ZIndex = 10 })

    local dismissed = false
    local function Dismiss()
        if dismissed then return end
        dismissed = true
        UI.Notifications = math.max(0, UI.Notifications - 1)
        if not Wrapper.Parent then return end
        local h = Wrapper.AbsoluteSize.Y
        Wrapper.AutomaticSize = AutoNone
        Wrapper.Size = UDim2.new(1, 0, 0, h)
        Utility:TweenObject(Card, { Position = UDim2.new(0, 40, 0, 0), BackgroundTransparency = 1 }, 0.2)
        Utility:TweenObject(Wrapper, { Size = UDim2.new(1, 0, 0, 0) }, 0.25)
        task.delay(0.3, function() Wrapper:Destroy() end)
    end
    Click.Activated:Connect(Dismiss)

    UI.Notifications += 1
    Utility:TweenObject(Card, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0.05 }, 0.3, Enum.EasingStyle.Back, DirOut)
    Bar.Size = UDim2.new(1, 0, 0, 2)
    Utility:TweenObject(Bar, { Size = UDim2.new(0, 0, 0, 2) }, N.Duration, Enum.EasingStyle.Linear, DirIn)
    task.delay(N.Duration, Dismiss)

    return { Dismiss = Dismiss }
end

