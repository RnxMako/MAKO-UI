----------------------------------------------------------------------
-- Rich text + inline icon helper
----------------------------------------------------------------------
local RichTags = {
    b = true, i = true, u = true, s = true, br = true, font = true, stroke = true, mark = true,
    uppercase = true, smallcaps = true, sc = true, uc = true, p = true,
}

local function ParseLine(line)
    local segs, pos, scan = {}, 1, 1
    local hasIcon = false
    while true do
        local s, e, name = line:find("<([%w_%-:]+)>", scan)
        if not s then break end
        if not RichTags[name:lower()] and ResolveIcon(name) then
            if s > pos then table.insert(segs, { t = "text", v = line:sub(pos, s - 1) }) end
            table.insert(segs, { t = "icon", v = name })
            hasIcon = true
            pos = e + 1
            scan = e + 1
        else
            scan = e + 1
        end
    end
    if pos <= #line then table.insert(segs, { t = "text", v = line:sub(pos) }) end
    return segs, hasIcon
end

local function CreateText(parent, text, props)
    props = props or {}
    local textSize = props.TextSize or 13
    local themeKey = props.ThemeKey or "Text"

    local pad = VexUI:Create("UIPadding", {
        PaddingLeft = UDim.new(0, props.PaddingLeft or 0),
        PaddingRight = UDim.new(0, props.PaddingRight or 0),
    })
    local container = VexUI:Create("Frame", {
        Parent = parent, BackgroundTransparency = 1,
        AutomaticSize = props.AutomaticSize or AutoY,
        Size = props.Size or UDim2.new(1, 0, 0, 0),
        LayoutOrder = props.LayoutOrder or 0,
        Position = props.Position,
        ZIndex = props.ZIndex or 1,
        Visible = props.Visible ~= false,
    }, {
        VexUI:Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
        pad,
    })

    local function mkLabel(str, order, par, inRow)
        return VexUI:Create("TextLabel", {
            Parent = par, LayoutOrder = order,
            AutomaticSize = inRow and AutoXY or AutoY,
            Size = inRow and UDim2.new() or UDim2.new(1, 0, 0, 0),
            Text = str, RichText = props.RichText ~= false,
            TextSize = textSize, FontFace = props.FontFace or TextFont,
            TextColor3 = props.TextColor3 or Color3.new(1, 1, 1),
            TextTransparency = props.TextTransparency or 0,
            TextWrapped = (not inRow) and props.TextWrapped ~= false,
            TextXAlignment = props.TextXAlignment or Left,
            TextYAlignment = inRow and Enum.TextYAlignment.Center or Enum.TextYAlignment.Top,
            ThemeID = (not props.Static) and { TextColor3 = themeKey } or nil,
        })
    end

    local current = ""
    local function Render(newText)
        for _, c in ipairs(container:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        current = tostring(newText or "")
        local lines = string.split((current:gsub("\\n", "\n")), "\n")
        for idx, line in ipairs(lines) do
            local segs, hasIcon = ParseLine(line)
            if not hasIcon then
                mkLabel(line == "" and " " or line, idx, container, false)
            else
                local row = VexUI:Create("Frame", {
                    Parent = container, BackgroundTransparency = 1, AutomaticSize = AutoXY,
                    Size = UDim2.new(), LayoutOrder = idx,
                }, { Utility:ListLayout("H", 3, Enum.VerticalAlignment.Center) })
                for order, seg in ipairs(segs) do
                    if seg.t == "text" then
                        mkLabel(seg.v, order, row, true)
                    else
                        local img = VexUI:Create("ImageLabel", {
                            Parent = row, LayoutOrder = order,
                            Size = UDim2.new(0, textSize + 3, 0, textSize + 3),
                            ScaleType = Enum.ScaleType.Fit,
                            ImageColor3 = props.TextColor3 or Color3.new(1, 1, 1),
                            ImageTransparency = props.TextTransparency or 0,
                            ThemeID = (not props.Static) and { ImageColor3 = themeKey } or nil,
                        })
                        SetIcon(img, seg.v)
                    end
                end
            end
        end
    end
    Render(text)

    return {
        Frame = container,
        UIPadding = pad,
        SetText = Render,
        GetText = function() return current end,
        SetVisible = function(v) container.Visible = v end,
    }
end

function Utility:ElText(parent, title, desc, props)
    props = props or {}
    local Title = CreateText(parent, title, {
