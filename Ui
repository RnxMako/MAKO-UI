        Parent = Card, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 38, 0, 24), BackgroundTransparency = 0.3,
        ThemeID = { BackgroundColor3 = "Placeholder" },
    }, { Corner(10), GStroke({ Alt = true }) })
    local Box = VexUI:Create("TextBox", {
        Parent = BoxFrame, Size = UDim2.new(1, 0, 1, 0), TextSize = 11, ClearTextOnFocus = false,
        Text = tostring(Slider.Value.Default), ZIndex = 3, ThemeID = { TextColor3 = "Text" },
    })

    local TrackH = IsTouch and 10 or 8
    local Track = VexUI:Create("Frame", {
        Parent = Card, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -56, 0.5, 0),
        Size = UDim2.new(0, Slider.Width, 0, TrackH), BackgroundTransparency = 0.1,
        ThemeID = { BackgroundColor3 = "Placeholder" },
    }, { Corner(8), GStroke({ Alt = true }) })
    local Fill = VexUI:Create("Frame", {
        Parent = Track, Size = UDim2.new(0, 0, 1, 0), ThemeID = { BackgroundColor3 = "Accent" },
    }, { Corner(8) })
    local Knob = VexUI:Create("Frame", {
        Parent = Fill, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14), BackgroundColor3 = Color3.fromRGB(250, 250, 250), ZIndex = 3,
    }, { Corner(8), VexUI:Create("UIStroke", { Thickness = 1, Transparency = 0.6, Color = Color3.new(0, 0, 0) }) })
    local Hit = VexUI:Create("TextButton", {
        Parent = Track, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1, 16, 0, 34), ZIndex = 6,
    })

    local Value = RoundTo(math.clamp(Slider.Value.Default, Slider.Value.Min, Slider.Value.Max), Slider.Step)
    local isFocusing = false
    local function alphaOf(v)
        local range = Slider.Value.Max - Slider.Value.Min
        return range == 0 and 0 or (v - Slider.Value.Min) / range
    end
    local function visual(v, animate)
        local a = math.clamp(alphaOf(v), 0, 1)
        if animate then
            Utility:TweenObject(Fill, { Size = UDim2.new(a, 0, 1, 0) }, 0.1, Enum.EasingStyle.Linear)
        else
            Fill.Size = UDim2.new(a, 0, 1, 0)
        end
        Box.Text = tostring(v)
    end
    local function commit(v, silent, animate)
        v = RoundTo(math.clamp(v, Slider.Value.Min, Slider.Value.Max), Slider.Step)
        visual(v, animate)
        if v ~= Value then
            Value = v
            if not silent then Safe(Slider.Callback, v) end
        end
    end

    visual(Value, false)
    Safe(Slider.Callback, Value)

    Box.Focused:Connect(function() isFocusing = true end)
    Box.FocusLost:Connect(function()
        isFocusing = false
        if Slider.Locked then visual(Value, false) return end
        local n = tonumber(Box.Text)
        if n then
            local old = Value
            Value = nil
            commit(n, false, true)
            if Value == nil then Value = old end
        else
            visual(Value, false)
        end
    end)

    local moveConn, endConn, activeInput
    local function stop()
        if moveConn then moveConn:Disconnect() moveConn = nil end
        if endConn then endConn:Disconnect() endConn = nil end
        activeInput = nil
        ctx.Scroll.ScrollingEnabled = true
        Utility:TweenObject(Knob, { Size = UDim2.new(0, 14, 0, 14) }, 0.12)
    end
    local function fromX(x)
        local a = math.clamp((x - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
        commit(Slider.Value.Min + a * (Slider.Value.Max - Slider.Value.Min), false, false)
    end

    Hit.InputBegan:Connect(function(input)
        if Slider.Locked or isFocusing then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            stop()
            activeInput = input
            ctx.Scroll.ScrollingEnabled = false
            Utility:TweenObject(Knob, { Size = UDim2.new(0, 18, 0, 18) }, 0.12)
            fromX(input.Position.X)
            moveConn = UserInputService.InputChanged:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseMovement or i == activeInput then
                    fromX(i.Position.X)
                end
            end)
            endConn = UserInputService.InputEnded:Connect(function(i)
                if i == activeInput
                    or (i.UserInputType == Enum.UserInputType.MouseButton1 and activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1) then
                    stop()
                end
            end)
        end
    end)

    function Slider:SetValue(val, silent) commit(val, silent, true) end
    function Slider:GetValue() return Value end
    function Slider:SetMax(val) Slider.Value.Max = val visual(Value, false) end
    function Slider:SetMin(val) Slider.Value.Min = val visual(Value, false) end
    function Slider:SetStep(val) Slider.Step = val end
    Slider._Cleanup = stop

    local entry = ctx:Register({ Title = Slider.Title, Desc = Slider.Desc, Icon = "settings-2", Type = "Slider", Frame = Card })
    FinishElement(ctx, Slider, Card, entry, Title, Desc)
    return Slider
end

