Builders.Keybind = function(ctx, Config)
    local Keybind = {
        Title = Config.Title or "Keybind", Desc = Config.Desc, Value = Config.Value or "F", Locked = Config.Locked,
        Callback = Config.Callback or function() end, OnPress = Config.OnPress, SizeY = Config.SizeY or DefaultH,
    }
    local Card, Inner = NewCard(ctx, Keybind.SizeY, { Reserve = 90 })
    local Title, Desc = Utility:ElText(Inner, Keybind.Title, Keybind.Desc)

    local KeyBtn = VexUI:Create("TextButton", {
        Parent = Card, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 30, 0, 24), AutomaticSize = AutoX, TextSize = 11, Text = Keybind.Value,
        BackgroundTransparency = 0.2, ZIndex = 6,
        ThemeID = { BackgroundColor3 = "Placeholder", TextColor3 = "Text" },
    }, { Corner(8), GStroke({ Alt = true }), Utility:Padding({ left = 9, right = 9 }) })

    local listening, conn = false, nil
    KeyBtn.Activated:Connect(function()
        if Keybind.Locked or listening then return end
        listening = true
        KeyBtn.Text = "..."
        conn = UserInputService.InputBegan:Connect(function(input)
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                conn:Disconnect()
                listening = false
                local name = input.KeyCode == Enum.KeyCode.Escape and Keybind.Value or input.KeyCode.Name
                KeyBtn.Text = name
                Keybind.Value = name
                Safe(Keybind.Callback, name)
            end
        end)
    end)

    local pressConn
    if Keybind.OnPress then
        pressConn = ctx.Window:_Connect(UserInputService.InputBegan, function(input, gp)
            if gp or listening or Keybind.Locked then return end
            if input.KeyCode.Name == Keybind.Value then Safe(Keybind.OnPress) end
        end)
    end

    function Keybind:SetValue(Val)
        KeyBtn.Text = Val
        Keybind.Value = Val
        Safe(Keybind.Callback, Val)
    end
    function Keybind:GetValue() return Keybind.Value end
    Keybind._Cleanup = function()
        if conn then conn:Disconnect() end
        if pressConn then pressConn:Disconnect() end
    end

    Safe(Keybind.Callback, Keybind.Value)
    local entry = ctx:Register({ Title = Keybind.Title, Desc = Keybind.Desc, Icon = "keyboard", Type = "Keybind", Frame = Card })
    FinishElement(ctx, Keybind, Card, entry, Title, Desc)
    return Keybind
end

