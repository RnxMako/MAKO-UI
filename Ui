Builders.Input = function(ctx, Config)
    local Input = {
        Title = Config.Title or "Input", Desc = Config.Desc, Value = Config.Value or "", Locked = Config.Locked,
        MaxSymbols = Config.MaxSymbols, Placeholder = Config.Placeholder,
        Callback = Config.Callback or function() end, SizeY = Config.SizeY or DefaultH,
    }
    local Card, Inner = NewCard(ctx, Input.SizeY, { Reserve = 150 })
    local Title, Desc = Utility:ElText(Inner, Input.Title, Input.Desc)

    local Frame = VexUI:Create("Frame", {
        Parent = Card, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.new(0, 134, 0, 26), BackgroundTransparency = 0.3,
        ThemeID = { BackgroundColor3 = "Placeholder" },
    }, { Corner(12), GStroke({ Alt = true }) })
    local Stroke = Frame:FindFirstChildOfClass("UIStroke")

    local Box = VexUI:Create("TextBox", {
        Parent = Frame, Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, Input.MaxSymbols and -38 or -8, 1, 0),
        Text = Input.Value, PlaceholderText = Input.Placeholder or "...", ClearTextOnFocus = false,
        ClipsDescendants = true, TextSize = 11, ZIndex = 5, TextXAlignment = Left,
        ThemeID = { TextColor3 = "Text" },
    }, { Utility:Padding({ left = 9, right = 4 }) })

    local MaxLabel
    if Input.MaxSymbols then
        MaxLabel = VexUI:Create("TextLabel", {
            Parent = Frame, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0),
            Size = UDim2.new(0, 30, 0, 16), Text = #Input.Value .. "/" .. Input.MaxSymbols, TextSize = 9,
            TextTransparency = 0.5, ThemeID = { TextColor3 = "Text" },
        })
        Box:GetPropertyChangedSignal("Text"):Connect(function()
            if #Box.Text > Input.MaxSymbols then Box.Text = string.sub(Box.Text, 1, Input.MaxSymbols) end
            MaxLabel.Text = #Box.Text .. "/" .. Input.MaxSymbols
        end)
    end

    Box.Focused:Connect(function()
        if Input.Locked then Box:ReleaseFocus() return end
        VexUI:SetThemeKey(Stroke, "Color", "Accent")
    end)
    Box.FocusLost:Connect(function(enter)
        VexUI:SetThemeKey(Stroke, "Color", "Outline")
        if Input.Locked or not enter then return end
        Input.Value = Box.Text
        Safe(Input.Callback, Box.Text)
    end)

    function Input:SetValue(Val)
        Box.Text = tostring(Val)
        Input.Value = Box.Text
        Safe(Input.Callback, Box.Text)
    end
    function Input:GetValue() return Box.Text end
    function Input:SetMaxSymbols(n)
        Input.MaxSymbols = n
        if MaxLabel then MaxLabel.Text = #Box.Text .. "/" .. n end
    end
    function Input:SetPlaceholder(t) Box.PlaceholderText = t end

    if not Input.Locked then Safe(Input.Callback, Input.Value) end

    local entry = ctx:Register({ Title = Input.Title, Desc = Input.Desc, Icon = "text-cursor-input", Type = "Input", Frame = Card })
    FinishElement(ctx, Input, Card, entry, Title, Desc)
    return Input
end

