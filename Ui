local Builders = {}

local function NewCard(ctx, sizeY, opts)
    opts = opts or {}
    local children = { Corner(14) }
    if not opts.NoStroke then table.insert(children, GStroke()) end
    local Card = VexUI:Create("Frame", {
        Parent = ctx.Parent, AutomaticSize = AutoY, ClipsDescendants = true,
        BackgroundTransparency = opts.Transparency or 0.5,
        Size = UDim2.new(1, 0, 0, sizeY), LayoutOrder = opts.LayoutOrder or 0,
        BackgroundColor3 = opts.Color,
        ThemeID = (not opts.Color) and { BackgroundColor3 = "ElementColor" } or nil,
    }, children)
    local Inner = VexUI:Create("Frame", {
        Parent = Card, BackgroundTransparency = 1, AutomaticSize = AutoY,
        Size = UDim2.new(1, -(opts.Reserve or 0), 0, sizeY),
    }, {
        Utility:ListLayout("V", 1, Enum.VerticalAlignment.Center),
        Utility:Padding({ top = 9, bottom = 9 }),
    })
    return Card, Inner
end

local function HoverEffect(trigger, card, base, hover)
    trigger.MouseEnter:Connect(function()
        Utility:TweenObject(card, { BackgroundTransparency = hover }, 0.12)
    end)
    trigger.MouseLeave:Connect(function()
        Utility:TweenObject(card, { BackgroundTransparency = base }, 0.12)
    end)
end

local function FinishElement(ctx, el, Card, entry, Title, Desc)
    el.Root = Card
    function el:SetTitle(t)
        if Title then Title.SetText(t) end
        el.Title = t
        entry.Title = t
    end
    function el:SetDesc(t)
        if Desc then
            Desc.SetVisible(t ~= nil and t ~= "")
            Desc.SetText(t or "")
        end
        el.Desc = t
        entry.Desc = t
    end
    function el:Close()
        for i, e in ipairs(ctx.Window.SearchIndex) do
            if e == entry then table.remove(ctx.Window.SearchIndex, i) break end
        end
        if el._Cleanup then el._Cleanup() end
        Card:Destroy()
    end
    function el:Lock()
        el.Locked = true
        LockedElm(Card, true)
    end
    function el:UnLock()
        el.Locked = false
        LockedElm(Card, false)
    end
    if el.Locked then el:Lock() end
end

