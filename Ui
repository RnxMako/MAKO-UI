Builders.Dropdown = function(ctx, Config)
    local Dropdown = {
        Title = Config.Title or "Dropdown", Desc = Config.Desc, Value = Config.Value or "",
        Locked = Config.Locked, Multi = Config.Multi or false,
        Option = Config.Option or Config.Values or {}, Options = {},
        Callback = Config.Callback or function() end, ASpeed = 0.2,
        SizeY = Config.SizeY or DefaultH,
    }

    local Holder = VexUI:Create("Frame", {
        Parent = ctx.Parent, BackgroundTransparency = 1, AutomaticSize = AutoY,
        Size = UDim2.new(1, 0, 0, Dropdown.SizeY),
    }, { Utility:ListLayout("V", 0) })

    local hctx = setmetatable({ Parent = Holder }, { __index = ctx })
    local Header, Inner = NewCard(hctx, Dropdown.SizeY, { Reserve = 140, LayoutOrder = 1 })
    local Title, Desc = Utility:ElText(Inner, Dropdown.Title, Dropdown.Desc)

    local ValueFrame = VexUI:Create("Frame", {
        Parent = Header, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.new(0, 124, 0, 26), BackgroundTransparency = 0.3,
        ThemeID = { BackgroundColor3 = "Placeholder" },
    }, { Corner(12), GStroke({ Alt = true }) })
    local Chevron = VexUI:Create("ImageLabel", {
        Parent = ValueFrame, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -5, 0.5, 0),
        Size = UDim2.new(0, 16, 0, 16), ZIndex = 11, ThemeID = { ImageColor3 = "IconColor" },
    })
    SetIcon(Chevron, "chevron-down")
    local Box = VexUI:Create("TextBox", {
        Parent = ValueFrame, Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -28, 1, 0),
        TextSize = 11, ClipsDescendants = true, ClearTextOnFocus = true, ZIndex = 10,
        PlaceholderText = "Select...", TextXAlignment = Left, ThemeID = { TextColor3 = "Text" },
    })
    local TRG = VexUI:Create("TextButton", { Parent = Header, Size = UDim2.new(1, 0, 1, 0), ZIndex = 5 })
    HoverEffect(TRG, Header, 0.5, 0.38)

    local ListHolder = VexUI:Create("Frame", {
        Parent = Holder, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), ClipsDescendants = true,
        BackgroundTransparency = 1,
    })
    local Scroll = VexUI:Create("ScrollingFrame", {
        Parent = ListHolder, Size = UDim2.new(1, 0, 1, 0), AutomaticCanvasSize = AutoY,
        ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = 2,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        ThemeID = { ScrollBarImageColor3 = "IconColor" },
    }, { Utility:ListLayout("V", 4), Utility:Padding({ top = 6, bottom = 6, left = 2, right = 4 }) })
    local ListLayout = Scroll:FindFirstChildOfClass("UIListLayout")

    local Items = {}
    local DropOpen, isTyping = false, false

    local function listHeight()
        local visible = 0
        for _, e in pairs(Items) do if e.Frame.Visible then visible += 1 end end
        if visible == 0 then return 0 end
        return math.clamp(Unscale(ListLayout.AbsoluteContentSize.Y) + 12, 0, 170)
    end
    local function resize()
        if DropOpen then
            Utility:TweenObject(ListHolder, { Size = UDim2.new(1, 0, 0, listHeight()) }, Dropdown.ASpeed, QuadInOut)
        end
    end
    local function openDropdown()
        if Dropdown.Locked then return end
        DropOpen = true
        task.defer(function()
            Utility:TweenObject(ListHolder, { Size = UDim2.new(1, 0, 0, listHeight()) }, Dropdown.ASpeed, QuadInOut)
            Utility:TweenObject(Chevron, { Rotation = 180 }, 0.15)
        end)
    end
    local function closeDropdown()
        DropOpen = false
        Utility:TweenObject(ListHolder, { Size = UDim2.new(1, 0, 0, 0) }, Dropdown.ASpeed, QuadInOut)
        Utility:TweenObject(Chevron, { Rotation = 0 }, 0.15)
    end

    local function displayText()
        if Dropdown.Multi then return table.concat(Dropdown.Options, ", ") end
        return tostring(Dropdown.Value or "")
    end

    local function paint(entry, selected, animate)
        local d = animate and 0.12 or 0
        Utility:TweenObject(entry.Fill, { BackgroundTransparency = selected and 0.72 or 1 }, d)
        Utility:TweenObject(entry.Btn, { TextTransparency = selected and 0 or 0.4 }, d)
        Utility:TweenObject(entry.Check, { ImageTransparency = selected and 0 or 1 }, d)
    end

    local function syncVisual(animate)
        for item, entry in pairs(Items) do
            local sel
            if Dropdown.Multi then
                sel = table.find(Dropdown.Options, item) ~= nil
            else
                sel = (Dropdown.Value == item)
            end
            paint(entry, sel, animate)
        end
        if not isTyping then Box.Text = displayText() end
    end

    Box.Focused:Connect(function()
        if Dropdown.Locked then Box:ReleaseFocus() return end
        isTyping = true
        openDropdown()
    end)
    Box:GetPropertyChangedSignal("Text"):Connect(function()
        if not isTyping then return end
        local q = string.lower(Box.Text)
        for item, entry in pairs(Items) do
            entry.Frame.Visible = (q == "") or (string.find(string.lower(tostring(item)), q, 1, true) ~= nil)
        end
        task.defer(resize)
    end)
    Box.FocusLost:Connect(function()
        isTyping = false
        for _, entry in pairs(Items) do entry.Frame.Visible = true end
        Box.Text = displayText()
        task.defer(resize)
    end)

    TRG.Activated:Connect(function()
        if Dropdown.Locked then return end
        if DropOpen then closeDropdown() else openDropdown() end
    end)

    function Dropdown:Refresh(options)
        Dropdown.Option = options or Dropdown.Option
        for _, c in ipairs(Scroll:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        Items = {}
        for idx, Item in ipairs(Dropdown.Option) do
            local Frame = VexUI:Create("Frame", {
                Parent = Scroll, Name = tostring(Item), LayoutOrder = idx, Size = UDim2.new(1, 0, 0, IsTouch and 30 or 26),
                BackgroundTransparency = 0.5, ClipsDescendants = true,
                ThemeID = { BackgroundColor3 = "ElementColor" },
            }, { Corner(12), GStroke({ Alt = true }) })
            local Fill = VexUI:Create("Frame", {
                Parent = Frame, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
                ThemeID = { BackgroundColor3 = "Accent" },
            })
            local Check = VexUI:Create("ImageLabel", {
                Parent = Frame, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
                Size = UDim2.new(0, 14, 0, 14), ImageTransparency = 1, ZIndex = 3,
                ThemeID = { ImageColor3 = "Accent" },
            })
            SetIcon(Check, "check")
            local Btn = VexUI:Create("TextButton", {
                Parent = Frame, Size = UDim2.new(1, 0, 1, 0), Text = tostring(Item), TextSize = 11,
                TextTransparency = 0.4, TextXAlignment = Left, ZIndex = 4,
                ThemeID = { TextColor3 = "Text" },
            }, { Utility:Padding({ left = 10 }) })
            local entry = { Frame = Frame, Fill = Fill, Check = Check, Btn = Btn }
            Items[Item] = entry

            Btn.Activated:Connect(function()
                if Dropdown.Locked then return end
                if not Dropdown.Multi then
                    Dropdown.Value = Item
                    isTyping = false
                    Box:ReleaseFocus()
                    syncVisual(true)
                    closeDropdown()
                    Safe(Dropdown.Callback, Item)
                else
                    local pos = table.find(Dropdown.Options, Item)
                    if pos then table.remove(Dropdown.Options, pos) else table.insert(Dropdown.Options, Item) end
                    syncVisual(true)
                    Safe(Dropdown.Callback, Dropdown.Options)
                end
            end)
        end
        syncVisual(false)
        task.defer(resize)
        return Dropdown, Items
    end

    function Dropdown:SetValue(Value, fire)
        if Dropdown.Multi then
            Dropdown.Options = {}
            if type(Value) == "table" then
                for _, v in ipairs(Value) do table.insert(Dropdown.Options, v) end
            elseif Value ~= nil and Value ~= "" then
                table.insert(Dropdown.Options, Value)
            end
        else
            Dropdown.Value = Value
        end
        syncVisual(true)
        if fire then Safe(Dropdown.Callback, Dropdown.Multi and Dropdown.Options or Dropdown.Value) end
    end
    function Dropdown:GetValue() return Dropdown.Multi and Dropdown.Options or Dropdown.Value end
    function Dropdown:Collapse() closeDropdown() end
    function Dropdown:Expand() openDropdown() end

    -- initial value
    if Dropdown.Multi then
        if type(Dropdown.Value) == "table" then
            for _, v in ipairs(Dropdown.Value) do table.insert(Dropdown.Options, v) end
        elseif Dropdown.Value ~= "" then
            table.insert(Dropdown.Options, Dropdown.Value)
        end
    end
    Dropdown:Refresh(Dropdown.Option)

    local entry = ctx:Register({ Title = Dropdown.Title, Desc = Dropdown.Desc, Icon = "list", Type = "Dropdown", Frame = Holder })
    FinishElement(ctx, Dropdown, Header, entry, Title, Desc)
    Dropdown.Root = Holder
    function Dropdown:Close()
        for i, e in ipairs(ctx.Window.SearchIndex) do
            if e == entry then table.remove(ctx.Window.SearchIndex, i) break end
        end
        Holder:Destroy()
    end
    return Dropdown
end

