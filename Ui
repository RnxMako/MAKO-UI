    local function RenderSearch(query)
        ClearSearchResults()
        local q = string.lower(query)
        if q == "" then
            Utility:TweenObject(SearchPanel, { Size = UDim2.new(0, 250, 0, 0) }, 0.15)
            task.delay(0.16, function() if SearchBox.Text == "" then SearchPanel.Visible = false end end)
            return
        end
        SearchPanel.Visible = true
        local count = 0
        for _, entry in ipairs(Window.SearchIndex) do
            if entry.Title and entry.SelectFn then
                local hay = string.lower(Strip(entry.Title) .. " " .. Strip(entry.Desc) .. " " .. tostring(entry.TabTitle or ""))
                if string.find(hay, q, 1, true) and count < 20 then
                    count += 1
                    local Row = VexUI:Create("TextButton", {
                        Parent = SearchScroll, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = count, ZIndex = 62,
                        BackgroundTransparency = 0.4, ThemeID = { BackgroundColor3 = "ElementColor" },
                    }, { Corner(12) })
                    local Ic = VexUI:Create("ImageLabel", {
                        Parent = Row, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0),
                        Size = UDim2.new(0, 16, 0, 16), ZIndex = 63, ThemeID = { ImageColor3 = "Search.Icon|IconColor" },
                    })
                    SetIcon(Ic, entry.Icon or "circle")
                    VexUI:Create("TextLabel", {
                        Parent = Row, Position = UDim2.new(0, 32, 0, 0), Size = UDim2.new(1, -100, 1, 0),
                        Text = Strip(entry.Title), TextSize = 12, TextXAlignment = Left, ZIndex = 63,
                        TextTruncate = Enum.TextTruncate.AtEnd, ThemeID = { TextColor3 = "Search.Text|Text" },
                    })
                    VexUI:Create("TextLabel", {
                        Parent = Row, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0),
                        Size = UDim2.new(0, 62, 1, 0), Text = tostring(entry.TabTitle or ""), TextSize = 10,
                        TextTransparency = 0.55, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 63,
                        TextTruncate = Enum.TextTruncate.AtEnd, ThemeID = { TextColor3 = "Search.Text|Text" },
                    })
                    Row.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            JumpTo(entry)
                            SearchBox.Text = ""
                            SearchBox:ReleaseFocus()
                        end
                    end)
                end
            end
        end
        if count == 0 then
            VexUI:Create("TextLabel", {
                Parent = SearchScroll, Size = UDim2.new(1, 0, 0, 28), Text = "No results", TextSize = 11,
                TextTransparency = 0.5, ZIndex = 62, ThemeID = { TextColor3 = "Text" },
