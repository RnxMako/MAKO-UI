-- TOGGLE ---------------------------------------------------------------
Builders.Toggle = function(ctx, Config)
    local Togglee = {
        Title = Config.Title or "Toggle", Desc = Config.Desc, Icon = Config.Icon, Default = Config.Default,
        Value = Config.Value, SizeY = Config.SizeY or DefaultH, Locked = Config.Locked,
        Callback = Config.Callback or function() end,
    }

    if Togglee.Value then
        -- Segmented selector mode
        local Card = VexUI:Create("Frame", {
            Parent = ctx.Parent, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, ClipsDescendants = true,
        })
        local Holder = VexUI:Create("Frame", {
            Parent = Card, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0.5,
            ThemeID = { BackgroundColor3 = "ElementColor" },
        }, { Corner(14), GStroke() })
        local count = math.max(#Togglee.Value, 1)
        local SegW = 1 / count
        local Pill = VexUI:Create("Frame", {
            Parent = Holder, Size = UDim2.new(SegW, -6, 1, -6), Position = UDim2.new(0, 3, 0, 3),
            BackgroundTransparency = 0.45, ThemeID = { BackgroundColor3 = "Accent" },
        }, { Corner(11) })
        local Buttons = {}
        local current = 1

        local function ResolveIndex()
            local d = Togglee.Default
            if d == nil then return 1 end
            if typeof(d) == "number" then return math.clamp(d, 1, count) end
            for i, v in ipairs(Togglee.Value) do if v == d then return i end end
            return 1
        end

        function Togglee:SetValue(Value, sil)
            local index = Value
            if typeof(index) ~= "number" then
                for i, v in ipairs(Togglee.Value) do if v == index then index = i break end end
            end
            index = math.clamp(typeof(index) == "number" and index or 1, 1, count)
            current = index
            Utility:TweenObject(Pill, { Position = UDim2.new(SegW * (index - 1), 3, 0, 3) }, 0.25, QuadOut, DirOut)
            for i, btn in ipairs(Buttons) do
                Utility:TweenObject(btn, { TextTransparency = (i == index) and 0 or 0.45 }, 0.2)
            end
            if not sil then Safe(Togglee.Callback, Togglee.Value[index], index) end
            return Togglee
        end
        function Togglee:GetValue() return Togglee.Value[current], current end

        for i, valueText in ipairs(Togglee.Value) do
            local Btn = VexUI:Create("TextButton", {
                Parent = Holder, Size = UDim2.new(SegW, 0, 1, 0), Position = UDim2.new(SegW * (i - 1), 0, 0, 0),
                Text = tostring(valueText), TextTransparency = 0.45, TextSize = 12, ZIndex = 5,
                ThemeID = { TextColor3 = "Text" },
            })
            Buttons[i] = Btn
            Btn.Activated:Connect(function()
                if Togglee.Locked then return end
                Togglee:SetValue(i)
            end)
        end
        Togglee:SetValue(ResolveIndex(), true)
        Safe(Togglee.Callback, Togglee.Value[ResolveIndex()], ResolveIndex())

        local entry = ctx:Register({ Title = Togglee.Title, Desc = Togglee.Desc, Icon = "toggle-left", Type = "Toggle", Frame = Card })
        FinishElement(ctx, Togglee, Card, entry, nil, nil)
        return Togglee
    end

    -- Switch mode
    local Card, Inner = NewCard(ctx, Togglee.SizeY, { Reserve = 64 })
    local Title, Desc = Utility:ElText(Inner, Togglee.Title, Togglee.Desc)

    local Track = VexUI:Create("Frame", {
        Parent = Card, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 42, 0, 24), BackgroundTransparency = 0.2,
        ThemeID = { BackgroundColor3 = "Placeholder" },
    }, { Corner(12), GStroke({ Alt = true }) })
    local Knob = VexUI:Create("Frame", {
        Parent = Track, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 12, 0.5, 0),
        Size = UDim2.new(0, 16, 0, 16), BackgroundColor3 = Color3.fromRGB(245, 245, 245),
        BackgroundTransparency = 0.25,
    }, { Corner(8) })

    local TRG = VexUI:Create("TextButton", { Parent = Card, Size = UDim2.new(1, 0, 1, 0), ZIndex = 5 })
    HoverEffect(TRG, Card, 0.5, 0.38)

    local Val = (Togglee.Default == true)
    local function Visual(v, animate)
        local dur = animate and 0.25 or 0
        Utility:TweenObject(Knob, {
            Position = UDim2.new(0, v and 30 or 12, 0.5, 0),
            BackgroundTransparency = v and 0 or 0.25,
            Size = UDim2.new(0, 16, 0, 16),
        }, dur, Enum.EasingStyle.Back, DirOut)
        VexUI:SetThemeKey(Track, "BackgroundColor3", v and "Accent" or "Placeholder")
        Utility:TweenObject(Track, { BackgroundTransparency = v and 0 or 0.2 }, dur)
    end

    function Togglee:SetValue(newValue, silent)
        Val = newValue and true or false
        Togglee.Default = Val
        Visual(Val, true)
        if not silent then Safe(Togglee.Callback, Val) end
        return Togglee
    end
    function Togglee:GetValue() return Val end
    function Togglee:Toggle() return Togglee:SetValue(not Val) end

    TRG.MouseButton1Down:Connect(function()
        Utility:TweenObject(Knob, { Size = UDim2.new(0, 20, 0, 14) }, 0.12)
    end)
    local function release()
        Utility:TweenObject(Knob, { Size = UDim2.new(0, 16, 0, 16) }, 0.12)
    end
    TRG.MouseButton1Up:Connect(release)
    TRG.MouseLeave:Connect(release)
    TRG.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then release() end end)
    TRG.Activated:Connect(function()
        if Togglee.Locked then return end
        Togglee:SetValue(not Val)
    end)

    Visual(Val, false)
    Safe(Togglee.Callback, Val)

    local entry = ctx:Register({ Title = Togglee.Title, Desc = Togglee.Desc, Icon = "toggle-left", Type = "Toggle", Frame = Card })
    FinishElement(ctx, Togglee, Card, entry, Title, Desc)
    return Togglee
end

