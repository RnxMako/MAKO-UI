        local maxX = math.min(MAX_W, math.floor((vp.X - 8) / scale))
        local maxY = math.min(MAX_H, math.floor((vp.Y - 8) / scale))
        sizeX = math.clamp(sizeX, MIN_W, math.max(MIN_W, maxX))
        sizeY = math.clamp(sizeY, MIN_H, math.max(MIN_H, maxY))
        Window.Size = UDim2.new(0, sizeX, 0, sizeY)
